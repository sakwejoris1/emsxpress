{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/admin/rates",
      "destination": "/api/admin/operations?resource=rates"
    },
    {
      "source": "/api/admin/locations",
      "destination": "/api/admin/operations?resource=locations"
    },
    {
      "source": "/api/admin/inquiries",
      "destination": "/api/admin/operations?resource=inquiries"
    },
    {
      "source": "/api/admin/invoices",
      "destination": "/api/admin/operations?resource=invoices"
    },
    {
      "source": "/api/admin/position",
      "destination": "/api/admin/operations?resource=position"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
